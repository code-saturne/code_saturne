<ModuleRules version="1.0" module="TurbulentFlux">
  <!--
    Rules for scalar turbulent flux models.
    Centralises rules from:
    - cs_setup.cpp : create {scalar}_turbulent_flux and {scalar}_alpha fields
    - cs_gui.cpp   : _variable_turbulent_flux_model()
    Used by:
    - Solver : cs_turbulent_flux_rules_manager
    - GUI    : NumericalParamEquationModel (ElementTree)
  -->

  <!-- =========================================================== -->
  <!-- Definitions                                                 -->
  <!-- =========================================================== -->

  <Definitions>

    <TypeDef name="TurbulentFluxModel">
      <Value name="SGDH"    numeric="0"  description="Simple Gradient Diffusion Hypothesis"/>
      <Value name="GGDH"    numeric="10" description="Generalized Gradient Diffusion Hypothesis"/>
      <Value name="EB-GGDH" numeric="11" description="Elliptic Blending GGDH"/>
      <Value name="AFM"     numeric="20" description="Algebraic Flux Model"/>
      <Value name="EB-AFM"  numeric="21" description="Elliptic Blending AFM"/>
      <Value name="DFM"     numeric="30" description="Differential Flux Model"/>
      <Value name="EB-DFM"  numeric="31" description="Elliptic Blending DFM"/>
    </TypeDef>

    <TypeDef name="FieldType">
      <Value>variable</Value>
      <Value>property</Value>
    </TypeDef>

    <TypeDef name="TurbulenceCompatibility">
      <Description>
        SGDH is usable with all turbulence models.
        GGDH, AFM, DFM require an RSM model(Rij, second order).
        EB-GGDH, EB-AFM, EB-DFM require Rij-EBRSM.
      </Description>
      <Value>Rij-epsilon</Value>
      <Value>Rij-SSG</Value>
      <Value>Rij-EBRSM</Value>
    </TypeDef>

  </Definitions>

  <!-- =========================================================== -->
  <!-- Field creation rules                                        -->
  <!-- {scalar} is replaced by the user scalar name                -->
  <!-- =========================================================== -->

  <FieldCreationRules>

    <!-- SGDH (0) : no additional field -->
    <Rule Model="SGDH" NumericValue="0">
      <Description>
        SGDH: Simple Gradient Diffusion Hypothesis.
        Requires no additional field.
        Usable with all turbulence models.
      </Description>
    </Rule>

    <!-- GGDH (10) : {scalar}_turbulent_flux property -->
    <Rule Model="GGDH" NumericValue="10">
      <Description>
        GGDH: Generalized Gradient Diffusion Hypothesis.
        Requires an Rij turbulence model (second order).
      </Description>
      <Field NameTemplate="{scalar}_turbulent_flux"
             LabelTemplate="{scalar} Turbulent Flux"
             Dimension="3"
             Type="property"
             PostProcess="1" Log="1"/>
    </Rule>

    <!-- EB-GGDH (11) : {scalar}_turbulent_flux + {scalar}_alpha -->
    <Rule Model="EB-GGDH" NumericValue="11">
      <Description>
        EB-GGDH: Elliptic Blending GGDH.
        Requires Rij-EBRSM.
        Solves an elliptical equation on a scalar_alpha field.
      </Description>
      <Field NameTemplate="{scalar}_turbulent_flux"
             LabelTemplate="{scalar} Turbulent Flux"
             Dimension="3"
             Type="property"
             PostProcess="1" Log="1"/>
      <Field NameTemplate="{scalar}_alpha"
             LabelTemplate="{scalar} Alpha"
             Dimension="1"
             Type="variable"/>
    </Rule>

    <!-- AFM (20) : {scalar}_turbulent_flux property -->
    <Rule Model="AFM" NumericValue="20">
      <Description>
        AFM: Algebraic Flux Model.
        Requires an Rij turbulence model (second order).
      </Description>
      <Field NameTemplate="{scalar}_turbulent_flux"
             LabelTemplate="{scalar} Turbulent Flux"
             Dimension="3"
             Type="property"
             PostProcess="1" Log="1"/>
    </Rule>

    <!-- EB-AFM (21) : {scalar}_turbulent_flux + {scalar}_alpha -->
    <Rule Model="EB-AFM" NumericValue="21">
      <Description>
        EB-AFM: Elliptic Blending GGDH.
        Requires Rij-EBRSM.
        Solves an elliptical equation on a scalar_alpha field.
      </Description>
      <Field NameTemplate="{scalar}_turbulent_flux"
             LabelTemplate="{scalar} Turbulent Flux"
             Dimension="3"
             Type="property"
             PostProcess="1" Log="1"/>
      <Field NameTemplate="{scalar}_alpha"
             LabelTemplate="{scalar} Alpha"
             Dimension="1"
             Type="variable"/>
    </Rule>

    <!-- DFM (30) : {scalar}_turbulent_flux elliptical equation variable -->
    <Rule Model="DFM" NumericValue="30">
      <Description>
        DFM: Differential Flux Model.
        Requires an Rij turbulence model (second order).
        Creates a coupled vector variable with anisotropic diffusivity.
      </Description>
      <Field NameTemplate="{scalar}_turbulent_flux"
             LabelTemplate="{scalar} Turbulent Flux"
             Dimension="3"
             Type="variable"
             Coupled="1"
             Clipping="1"
             PostProcess="1" Log="1"/>
    </Rule>

    <!-- EB-DFM (31) : {scalar}_turbulent_flux + {scalar}_alpha -->
    <Rule Model="EB-DFM" NumericValue="31">
      <Description>
        EB-DFM: Elliptic Blending DFM.
        Requires Rij-EBRSM.
        Creates a coupled vector variable with anisotropic diffusivity
        and solves an elliptical equation on a scalar_alpha field.
      </Description>
      <Field NameTemplate="{scalar}_turbulent_flux"
             LabelTemplate="{scalar} Turbulent Flux"
             Dimension="3"
             Type="variable"
             Coupled="1"
             Clipping="1"
             PostProcess="1" Log="1"/>
      <Field NameTemplate="{scalar}_alpha"
             LabelTemplate="{scalar} Alpha"
             Dimension="1"
             Type="variable"/>
    </Rule>

  </FieldCreationRules>

</ModuleRules>
