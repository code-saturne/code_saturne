<?xml version="1.0" encoding="UTF-8"?>

<ModuleRules version="1.0" module="Fields">

  <!--
    FieldsRules.xml
    Unique truth version for definition of code_saturne fields.
    Rules extracted from:
    - cs_setup.cpp: _create_variable_fields(), _create_property_fields()
    - cs_parameters.cpp: cs_parameters_define_auxiliary_fields()

    Read by:
    - C++ kernel: cs_fields_rules_manager
    - Python GUI: FieldsRulesManager (ElementTree)
  -->

  <!-- ==================================================================== -->
  <!-- Definitions                                                          -->
  <!-- ==================================================================== -->

  <Definitions>

    <TypeDef name="FieldType">
      <Value>variable</Value>
      <Value>property</Value>
      <Value>postprocess</Value>
      <Value>internal</Value>
    </TypeDef>

    <TypeDef name="FieldLocation">
      <Value>cells</Value>
      <Value>boundary_faces</Value>
      <Value>interior_faces</Value>
      <Value>vertices</Value>
    </TypeDef>

    <TypeDef name="CreationCondition">
      <Value>always</Value>
      <Value>vof_active</Value>
      <Value>non_compressible</Value>
      <Value>compressible_or_dilatable</Value>
      <Value>itytur_eq_2</Value>
      <Value>second_order</Value>
      <Value>itytur_eq_5</Value>
      <Value>model_eq_CS_TURB_K_OMEGA</Value>
      <Value>model_eq_CS_TURB_SPALART_ALLMARAS</Value>
      <Value>model_eq_CS_TURB_RIJ_EPSILON_EBRSM</Value>
      <Value>model_eq_CS_TURB_V2F_PHI</Value>
      <Value>model_eq_CS_TURB_V2F_BL_V2K</Value>
      <Value>model_eq_CS_TURB_LES_SMAGO_DYN</Value>
      <Value>model_eq_CS_TURB_NONE</Value>
      <Value>has_kinetic_st</Value>
      <Value>ieos_moist_air</Value>
      <Value>ieos_not_none_and_temp_or_energy</Value>
      <Value>thermal_internal_energy</Value>
      <Value>cflt_active</Value>
      <Value>cflp_active</Value>
      <Value>ale_active</Value>
      <Value>hybrid_blend_active</Value>
      <Value>hybrid_turb_eq_3</Value>
      <Value>hybrid_turb_eq_4</Value>
      <Value>hybrid_turb_eq_4_and_komega</Value>
      <Value>model_eq_CS_TURB_LES_TAUSGS_OR_KSGS</Value>
      <Value>model_eq_CS_TURB_RIJ_EPSILON_BFH</Value>
      <Value>vof_free_surface</Value>
    </TypeDef>

  </Definitions>

  <!-- ==================================================================== -->
  <!-- Field creation rules                                                 -->
  <!-- ==================================================================== -->

  <FieldCreationRules>

    <!-- =======================================================
         Base module
         Fields always present whatever the model.
         Source: cs_setup.cpp _create_variable_fields()
         ======================================================= -->

    <Module Name="Base">
      <Description>
        Base fields defined in all Navier-Stokes simulations.
        Velocity and Pressure are always present.
        VoidFraction only with the VoF model.
        MeshVelocity only with ALE.
      </Description>

      <!-- Velocity: always used, dim=3, solved coupled (u,v,w) -->
      <Rule Condition="always">
        <Description>Velocity field</Description>
        <Field Name="velocity" Label="Velocity" Dimension="3"
               Pointer="CS_ENUMF_(vel)" Type="variable"
               Location="cells" CoupledKey="1" AMRScheme="1"/>
      </Rule>

      <!-- Pressure: always used  -->
      <!-- iconv: 0 always (elliptical equation, no convection) -->
      <!-- istat: 1 if compressible/dilatable, 0 otherwise -->
      <!-- iwgrec: 1 for VoF, 0 otherwise -->
      <Rule Condition="always">
        <Description>Pressure field</Description>
        <Field Name="pressure" Label="Pressure" Dimension="1"
               Pointer="CS_ENUMF_(p)" Type="variable"
               Location="cells" NoConvection="1">
          <!-- istat=1 if compressible of dilatble, 0 otherwise -->
          <ConditionalParam Name="istat"
                            Condition="compressible_or_dilatable"
                            Value="1" Default="0"/>
          <!-- iwgrec=1 for VoF -->
          <ConditionalParam Name="iwgrec"
                            Condition="vof_active"
                            Value="1" Default="0"/>
        </Field>
      </Rule>

      <!-- VoF void fraction: only if vof_model > 0 -->
      <!-- idiff: 0 (pure convection without diffusion) -->
      <!-- ischcv: 4 (NVD/TVD scheme) -->
      <!-- limiter_choice: 11 (CICSAM) -->
      <!-- isstpc: 2 (Beta Limiter) -->
      <!-- physical boundaries: [0, 1] -->
      <Rule Condition="vof_active">
        <Description>Void fraction for VoF model</Description>
        <Field Name="void_fraction" Label="Void Fraction" Dimension="1"
               Pointer="CS_ENUMF_(void_f)" Type="variable"
               Location="cells"
               NoDiffusion="1"
               ConvectionScheme="4"
               Limiter="11"
               SlopeTest="2"
               ScalarMin="0.0"
               ScalarMax="1.0"/>
      </Rule>

      <!-- ALE mesh velocity: only if cs_glob_ale != CS_ALE_NONE -->
      <!-- istat=0, iconv=0, idifft=0: steady equation -->
      <!-- relaxv=1: no under-relaxation -->
      <!-- Note: for CDO ALE, located on nodes using
           cs_variable_cdo_field_create -->
      <Rule Condition="ale_active">
        <Description>Mesh velocity for ALE</Description>
        <Field Name="mesh_velocity" Label="Mesh Velocity" Dimension="3"
               Pointer="CS_ENUMF_(mesh_u)" Type="variable"
               Location="cells"
               CoupledKey="1"
               NoTimeTerm="1"
               NoConvection="1"
               NoDiffusionTranspose="1"
               RelaxV="1"/>
      </Rule>

    </Module>

    <!-- =======================================================
         Turbulence model
         Source: cs_setup.cpp _create_variable_fields()
         ======================================================= -->

    <Module Name="Turbulence">
      <Description>
        Turbulence fields created based on active model.
        Each model family has its own variables.
      </Description>

      <!-- itytur==2 : k-epsilon, k-epsilon-PL -->
      <!-- Deux scalaires : energie cinetique + taux de dissipation -->
      <Rule Condition="itytur_eq_2">
        <Description>k-epsilon and linear-production k-epsilon</Description>
        <DetailedDescription>
          The k-epsilon models are the most widely used in industrial CFD.
          They involve 2 additional transport equations:
          - The turbulent kinetic energy, k (m2/s2), which represents the intensity of turbulent fluctuations.
          - The rate of dissipation epsilon (m2/s3) which characterises the rate at which the turbulent kinetic energy is dissipated.
          These two fields allow computing the turbulent viscosity
          mu_t = rho * C_mu * k^2 / epsilon.
          Used for industrial flows with high y+ (y+ > 30).
        </DetailedDescription>
        <Field Name="k"       Label="Turb Kinetic Energy" Dimension="1"
               Pointer="CS_ENUMF_(k)"   Type="variable" Location="cells"/>
        <Field Name="epsilon" Label="Turb Dissipation"    Dimension="1"
               Pointer="CS_ENUMF_(eps)" Type="variable" Location="cells"/>
      </Rule>

      <!-- second_order: Rij-epsilon, Rij-SSG -->
      <!-- rij is a symmetric tensor dim=6 (r11, r22, r33, r12, r13, r23) -->
      <!-- CoupledKey=1: the components are solved together -->
      <!-- epsilon excluded for LES_TAUSGS which computes it algebraically -->
      <Rule Condition="second_order">
        <Description>RSM (Reynolds stress tensor) models</Description>
        <DetailedDescription>
          The RSM models directly solve the 6 components of the Reynolds stress tensor Rij = u_i u_j (r11, r22, r33, r12, r13, r23).
          Contrary to the k-epsilon models which assume an isotropic turbulent viscosity, the RSM models capture the anisotropy of the turbulence. Since the tenosrs are symmetrical, there are 6 independent components, which are solved in a coupled manner.
          These models are more precise for flows with curvature, rotation, or strongly anisotropic turbulence.
        </DetailedDescription>
        <Field Name="rij"     Label="Rij"             Dimension="6"
               Pointer="CS_ENUMF_(rij)" Type="variable"
               Location="cells" CoupledKey="1"/>
        <Field Name="epsilon" Label="Turb Dissipation" Dimension="1"
               Pointer="CS_ENUMF_(eps)" Type="variable"
               Location="cells"
               ExcludeModel="CS_TURB_LES_TAUSGS"/>
      </Rule>

      <!-- EBRSM only: additional alpha field -->
      <!-- Elliptical equation: istat=0, iconv=0, idircl=0 -->
      <!-- idircl=0 becuse a diagonal term is always present -->
      <Rule Condition="model_eq_CS_TURB_RIJ_EPSILON_EBRSM">
        <Description>EBRSM: alpha field for elliptic blending</Description>
        <DetailedDescription>
          The EBRSM (Elliptic Blending Reynolds Stress) model is an extension of RSM models which improves the near wall modeling. It introduces a scalar variable alpha which verifies an elliptical equation (with no convection o unsteady term). Alpha varies from 0 at the walli (viscous behavior) to 1 far from the wall (turbulent behavior).
        </DetailedDescription>
        <Field Name="alpha" Label="Alphap" Dimension="1"
               Pointer="CS_ENUMF_(alp_bl)" Type="variable"
               Location="cells"
               NoTimeTerm="1" NoConvection="1" NoDiagShift="1"/>
      </Rule>

      <!-- itytur==5: v2f-phi and v2f-BL-v2/k -->
      <!-- Extension of k-epsilon with phi variable (normal fluctuation) -->
      <Rule Condition="itytur_eq_5">
        <Description>v2f models: k, epsilon + phi</Description>
        <DetailedDescription>
          The v2f models are an extension of k-epsilon which improve the near wall behavior without resorting to damping functions.
          In addition to k and epsilon, they transport phi = v2/k, the normal component of normalized turbulence, which represents the redistribution of the turbulent energy.
          Phi has value 2/3 in isotropic turbulence and tends towards 0 at thr wall.
          These models are efficient especially for flows with separation or recirculation.
        </DetailedDescription>
        <Field Name="k"       Label="Turb Kinetic Energy" Dimension="1"
               Pointer="CS_ENUMF_(k)"   Type="variable" Location="cells"/>
        <Field Name="epsilon" Label="Turb Dissipation"    Dimension="1"
               Pointer="CS_ENUMF_(eps)" Type="variable" Location="cells"/>
        <Field Name="phi"     Label="Phi"                 Dimension="1"
               Pointer="CS_ENUMF_(phi)" Type="variable" Location="cells"/>
      </Rule>

      <!-- v2f-phi only: f_bar elliptical equation -->
      <Rule Condition="model_eq_CS_TURB_V2F_PHI">
        <Description>v2f-phi: f_bar</Description>
        <DetailedDescription>
          In the original v2f-phi model, f_bar is the elliptical source term for the phi equation. It verifies a  Helmholtz equation with no unsteady or convection term.
          f_bar smoothes the phi source term to avoid near wall numerical singularities numeriques en proche paroi.
        </DetailedDescription>
        <Field Name="f_bar" Label="f_bar" Dimension="1"
               Pointer="CS_ENUMF_(f_bar)" Type="variable"
               Location="cells"
               NoTimeTerm="1" NoConvection="1" NoDiagShift="1"/>
      </Rule>

      <!-- v2f-BL-v2/k uniquement : alpha equation elliptique -->
      <Rule Condition="model_eq_CS_TURB_V2F_BL_V2K">
        <Description>v2f-BL-v2/k : alpha equation elliptique</Description>
        <Field Name="alpha" Label="Alpha" Dimension="1"
               Pointer="CS_ENUMF_(alp_bl)" Type="variable"
               Location="cells"
               NoTimeTerm="1" NoConvection="1" NoDiagShift="1"/>
      </Rule>

      <!-- k-omega-SST : omega a la place d'epsilon -->
      <Rule Condition="model_eq_CS_TURB_K_OMEGA">
        <Description>k-omega SST: k + specific dissipation rate omega</Description>
        <DetailedDescription>
          The k-omega SST (Shear Stress Transport) model combines the advantages fof the k-omega model near the wall and of the du k-epsilon model far from the wall, using a miwing function. Omega (1/s) is the specific dissipation rate: omega = epsilon / (C_mu * k).
          The SST model is considered the bast RANS model for flows with adverse pressure gradient and detachment.
          Usable with small (y+ ~ 1) or high (y+ > 30) y+.
        </DetailedDescription>
        <Field Name="k"     Label="Turb Kinetic Energy" Dimension="1"
               Pointer="CS_ENUMF_(k)"   Type="variable" Location="cells"/>
        <Field Name="omega" Label="Omega"               Dimension="1"
               Pointer="CS_ENUMF_(omg)" Type="variable" Location="cells"/>
      </Rule>

      <!-- Spalart-Allmaras: single equation, nu_tilda -->
      <Rule Condition="model_eq_CS_TURB_SPALART_ALLMARAS">
        <Description>Spalart-Allmaras: one equation model</Description>
        <DetailedDescription>
          The Spalart-Allmaras is a single equation model which transports
          directly the modified turbulent viscosity nu_tilda (m2/s).
          Widely used in external aerodynamic applications (aviation, automobile) for its robustness and simplicity.
          It does not resolve k or epsilon — all the turbulence information is in nu_tilda. The real turbulent viscosity if obtained through a damping function: mu_t = rho * f_v1 * nu_tilda.
        </DetailedDescription>
        <Field Name="nu_tilda" Label="NuTilda" Dimension="1"
               Pointer="CS_ENUMF_(nusa)" Type="variable" Location="cells"/>
      </Rule>

    </Module>

    <!-- =======================================================
         Properties
         Source: cs_setup.cpp _create_property_fields()
         ======================================================= -->

    <Module Name="Properties">
      <Description>
        Basic physical properties fields.
        Density and viscosity always present.
        Epsilon SGS for LES with tau_SGS transport.
        Hybrid HTLES fields for hybrid RANS/LES turbulence.
        CFL hidden in steady flow.
        TotalPressure only if incompressible.
      </Description>

      <!-- density + boundary_density: always, postprocess -->
      <!-- Hidden later if constants in cs_parameters_*_complete -->
      <Rule Condition="always">
        <Description>Density at cells and boundary faces</Description>
        <Field Name="density"          Label="Density"          Dimension="1"
               Pointer="CS_ENUMF_(rho)"   Type="property"
               Location="cells"        PostProcess="1" Log="1"/>
        <Field Name="boundary_density" Label="Boundary Density" Dimension="1"
               Pointer="CS_ENUMF_(rho_b)" Type="property"
               Location="boundary_faces"/>
      </Rule>

      <!-- molecular and turbulent viscosity: always -->
      <!-- turbulent_viscosity hidden if no turbulence (CS_TURB_NONE) -->
      <Rule Condition="always">
        <Description>Molecular and turbulent viscosity</Description>
        <Field Name="molecular_viscosity" Label="Laminar Viscosity" Dimension="1"
               Pointer="CS_ENUMF_(mu)"   Type="property" Location="cells"/>
        <Field Name="turbulent_viscosity" Label="Turb Viscosity"    Dimension="1"
               Pointer="CS_ENUMF_(mu_t)" Type="property" Location="cells"
               HideIfModel="CS_TURB_NONE"/>
      </Rule>

      <!-- epsilon SGS: only for LES with tau_SGS transport -->
      <!-- propriety (not solved variable) as is is algebric -->
      <Rule Condition="model_eq_CS_TURB_LES_TAUSGS_OR_KSGS">
        <Description>Epsilon SGS for LES with tau_SGS or k_SGS transport</Description>
        <Field Name="epsilon" Label="Epsilon SGS" Dimension="1"
               Pointer="CS_ENUMF_(eps)" Type="property"
               Location="cells" HasBoundary="1"/>
      </Rule>

      <!-- hybrid_blend: if hybrid convective scheme (ischcv=3) or hybrid_turb > 0 -->
      <Rule Condition="hybrid_blend_active">
        <Description>Hybride RANS/LES mixing function f_d</Description>
        <Field Name="hybrid_blend" Label="Hybrid blending function" Dimension="1"
               Type="property" Location="cells"/>
      </Rule>

      <!-- hybrid_sas_source_term: only if hybrid_turb == 3 (SAS) -->
      <Rule Condition="hybrid_turb_eq_3">
        <Description>Source term for hybrid SAS model</Description>
        <Field Name="hybrid_sas_source_term" Label="SAS hybrid source term"
               Dimension="1" Type="property" Location="cells"/>
      </Rule>

      <!-- HTLES fields: only if hybrid_turb == 4 -->
      <Rule Condition="hybrid_turb_eq_4">
        <Description>Fields for HTLES hybrid model (hybrid_turb=4)</Description>
        <Field Name="k_tot"          Label="Energy total"              Dimension="1"
               Type="property" Location="cells"/>
        <Field Name="k_mod"          Label="Modelised Energy"          Dimension="1"
               Type="property" Location="cells"/>
        <Field Name="k_res"          Label="Resolved Energy"           Dimension="1"
               Type="property" Location="cells"/>
        <Field Name="eps_mod"        Label="Mean Dissipation"          Dimension="1"
               Type="property" Location="cells"/>
        <Field Name="htles_psi"      Label="Psi HTLES"                 Dimension="1"
               Type="property" Location="cells"/>
        <Field Name="htles_r"        Label="Energy ratio"              Dimension="1"
               Type="property" Location="cells"/>
        <Field Name="htles_t"        Label="Time scale HTLES"          Dimension="1"
               Type="property" Location="cells"/>
        <Field Name="htles_icc"      Label="ICC coefficient"           Dimension="1"
               Type="property" Location="cells"/>
        <Field Name="htles_fs"       Label="Shielding function"        Dimension="1"
               Type="property" Location="cells"/>
        <Field Name="Delta_max"      Label="Delta max"                 Dimension="1"
               Type="property" Location="cells"/>
        <Field Name="vel_mag_mean"   Label="Mean velocity mag."        Dimension="1"
               Type="property" Location="cells"/>
        <Field Name="velocity_mean"  Label="Vel Tavg"                  Dimension="3"
               Type="property" Location="cells"/>
        <Field Name="ui2_mean"       Label="Vel Tavg"                  Dimension="3"
               Type="property" Location="cells"/>
      </Rule>

      <!-- HTLES with k-omega: additional fields -->
      <Rule Condition="hybrid_turb_eq_4_and_komega">
        <Description>Additional HTLES fields for k-omega SST</Description>
        <Field Name="omg_mod"  Label="Mean Specific Dissipation" Dimension="1"
               Type="property" Location="cells"/>
        <Field Name="f1_kwsst" Label="Function F1 of k-omg SST" Dimension="1"
               Type="property" Location="cells"/>
      </Rule>

      <!-- s2 + vel_gradient_trace: only for k-omega SST, hidden -->
      <Rule Condition="model_eq_CS_TURB_K_OMEGA">
        <Description>S2 deformation tensor and trace of velocity gradient for k-omega</Description>
        <Field Name="s2"                Label="S2"                   Dimension="1"
               Type="property" Location="cells" Hidden="1"/>
        <Field Name="vel_gradient_trace" Label="Vel. Gradient Trace" Dimension="1"
               Type="property" Location="cells" Hidden="1"/>
      </Rule>

      <!-- courant_number and fourier_number: hidden for steady flow -->
      <!-- idtvar < 0 = steady flow -->
      <Rule Condition="always">
        <Description>Adimensional CFL and Fourier numbers</Description>
        <Field Name="courant_number" Label="CFL" Dimension="1"
               Type="property" Location="cells" HideIfSteady="1"/>
        <Field Name="fourier_number" Label="Fourier Number" Dimension="1"
               Type="property" Location="cells" HideIfSteady="1"/>
      </Rule>

      <!-- volume_courant_number: only for VoF -->
      <Rule Condition="vof_active">
        <Description>Volume Courant number for VoF</Description>
        <Field Name="volume_courant_number" Label="CourantNbVol" Dimension="1"
               Type="property" Location="cells" HideIfSteady="1"/>
      </Rule>

      <!-- total_pressure: only if incompressible -->
      <!-- Saved in auxiliary restart -->
      <Rule Condition="non_compressible">
        <Description>Total pressure (static + dynamic)</Description>
        <Field Name="total_pressure" Label="Total Pressure" Dimension="1"
               Type="property" Location="cells"
               RestartFile="auxiliary"/>
      </Rule>

      <!-- Dynamic Smagorinsky constant LES: Cs^2 -->
      <Rule Condition="model_eq_CS_TURB_LES_SMAGO_DYN">
        <Description>Smagorinsky constant squared for LES</Description>
        <Field Name="smagorinsky_constant^2" Label="Csdyn2" Dimension="1"
               Type="property" Location="cells"/>
      </Rule>

      <!-- BFH: additional beta2 -->
      <Rule Condition="model_eq_CS_TURB_RIJ_EPSILON_BFH">
        <Description>beta2 coefficient for the Rij BFH model</Description>
        <Field Name="algo:rij_beta2" Label="beta2" Dimension="1"
               Type="property" Location="cells"/>
      </Rule>

      <!-- drift_velocity: only if free surface VoF -->
      <Rule Condition="vof_free_surface">
        <Description>Drift velocity for free surface VoF</Description>
        <Field Name="drift_velocity" Label="Drift Velocity" Dimension="3"
               Type="property" Location="cells"/>
      </Rule>

    </Module>

    <!-- =======================================================
         Thermal module
         Source: cs_parameters.cpp
         cs_parameters_define_auxiliary_fields()
         ======================================================= -->

    <Module Name="Thermal">
      <Description>
        Auxiliary thermal fields created based on configuration.
        KineticST if active kinetic source term.
        Yv if humid air.
        Temperature if solved internal energy.
      </Description>

      <!-- has_kinetic_st: thermal kinetc source term -->
      <!-- Creates 4 fields: energiy, rho_k_prev, faces velocity -->
      <Rule Condition="has_kinetic_st">
        <Description>Fields for thermal kinetic source term</Description>
        <Field Name="kinetic_energy_thermal_st"
               Label="Kinetic Energy Thermal ST" Dimension="1"
               Type="property" Location="cells"
               PostProcess="1" Log="1"/>
        <Field Name="rho_k_prev"
               Label="rho_k_prev" Dimension="1"
               Type="internal" Location="cells"
               PostProcess="0"/>
        <Field Name="inner_face_velocity"
               Label="Inner Face Velocity" Dimension="3"
               Type="internal" Location="interior_faces"
               PostProcess="0"/>
        <Field Name="boundary_face_velocity"
               Label="Boundary Face Velocity" Dimension="3"
               Type="internal" Location="boundary_faces"
               PostProcess="0"/>
      </Rule>

      <!-- ieos==CS_EOS_MOIST_AIR: mass fraction of water vapor -->
      <Rule Condition="ieos_moist_air">
        <Description>Mass fraction of water vapor for humid air</Description>
        <Field Name="yv" Label="Water Vapor Mass Fraction" Dimension="1"
               Type="property" Location="cells"
               PostProcess="1" Log="1"/>
      </Rule>

      <!-- ieos != NONE and temperature or internal energy or gas mix -->
      <!-- Pressure gradient + isobaric heat capacity -->
      <Rule Condition="ieos_not_none_and_temp_or_energy">
        <Description>Champs compressibles gradient pression et Cp</Description>
        <Field Name="algo:pressure_gradient"
               Label="Pressure Gradient" Dimension="3"
               Type="internal" Location="cells" PostProcess="0"/>
        <Field Name="algo:pressure_increment_gradient"
               Label="Pressure Increment Gradient" Dimension="3"
               Type="internal" Location="cells" PostProcess="0"/>
        <Field Name="isobaric_heat_capacity"
               Label="Isobaric Heat Capacity" Dimension="1"
               Type="property" Location="cells"
               PostProcess="0" Log="1"/>
      </Rule>

      <!-- thermal_variable == CS_THERMAL_MODEL_INTERNAL_ENERGY -->
      <!-- Temperature created as proprety in this case -->
      <Rule Condition="thermal_internal_energy">
        <Description>Temperature (based on solved internal energy)</Description>
        <Field Name="temperature" Label="Temperature" Dimension="1"
               Type="property" Location="cells"
               PostProcess="1" Log="1"/>
      </Rule>

      <!-- cflt_active: thermal CFL -->
      <Rule Condition="cflt_active">
        <Description>CFL number for the thermal variable</Description>
        <Field Name="cfl_t" Label="CFL Thermal" Dimension="1"
               Type="postprocess" Location="cells"
               PostProcess="1" Log="1"/>
      </Rule>

      <!-- cflp_active: pressure CFL -->
      <Rule Condition="cflp_active">
        <Description>CFL number for pressure</Description>
        <Field Name="cfl_p" Label="CFL Pressure" Dimension="1"
               Type="postprocess" Location="cells"
               PostProcess="1" Log="1"/>
      </Rule>

    </Module>

  </FieldCreationRules>

  <!-- ==================================================================== -->
  <!-- Validation rules                                                     -->
  <!-- ==================================================================== -->

  <ValidationRules>

    <Constraint Target="field_dimension" Type="positive_strict">
      <ErrorMessage>Field dimension must be strictly positive</ErrorMessage>
    </Constraint>

    <Constraint Target="void_fraction" Type="range">
      <MinValue>0.0</MinValue>
      <MaxValue>1.0</MaxValue>
      <ErrorMessage>void fraction must be between 0 and 1</ErrorMessage>
    </Constraint>

  </ValidationRules>

  <!-- ==================================================================== -->
  <!-- Defaults                                                             -->
  <!-- ==================================================================== -->

  <Defaults>
    <Default Key="field_location"  Value="cells"/>
    <Default Key="field_post_vis"  Value="0"/>
    <Default Key="field_log"       Value="0"/>
  </Defaults>

  <!-- ==================================================================== -->
  <!-- Mappings                                                             -->
  <!-- ==================================================================== -->

  <Mappings>

    <EnumMapping Name="FieldLocation">
      <Entry Value="cells"          Flag="CS_MESH_LOCATION_CELLS"          Enum="1"/>
      <Entry Value="interior_faces" Flag="CS_MESH_LOCATION_INTERIOR_FACES" Enum="2"/>
      <Entry Value="boundary_faces" Flag="CS_MESH_LOCATION_BOUNDARY_FACES" Enum="3"/>
      <Entry Value="vertices"       Flag="CS_MESH_LOCATION_VERTICES"       Enum="4"/>
    </EnumMapping>

    <EnumMapping Name="FieldType">
      <Entry Value="variable"    Flag="CS_FIELD_VARIABLE"    Enum="1"/>
      <Entry Value="property"    Flag="CS_FIELD_PROPERTY"    Enum="2"/>
      <Entry Value="postprocess" Flag="CS_FIELD_POSTPROCESS" Enum="4"/>
      <Entry Value="internal"    Flag="0"                    Enum="0"/>
    </EnumMapping>

    <EnumMapping Name="CreationCondition">
      <Entry Value="itytur_eq_2"                        Enum="2"/>
      <Entry Value="second_order"                       Enum="3"/>
      <Entry Value="itytur_eq_5"                        Enum="5"/>
      <Entry Value="model_eq_CS_TURB_K_OMEGA"           Enum="60"/>
      <Entry Value="model_eq_CS_TURB_SPALART_ALLMARAS"  Enum="70"/>
      <Entry Value="model_eq_CS_TURB_RIJ_EPSILON_EBRSM" Enum="32"/>
