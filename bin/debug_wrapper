# This script defines a wrapper to launch an executable under a debugger.

# Global state
rank_id=-1

#-------------------------------------------------------------------------------
# Print supported debuggers list
#-------------------------------------------------------------------------------

print_debuggers() {
  cat << 'EOF'
gdb: GNU gdb debugger
cgdb: Console front-end to gdb
cuda-gdb: CUDA debugger
gdbgui: gdbgui gdb web browser interface
ddd: Data Display Debugger
emacs: Emacs with gdb debugger
kdbg: KDbg
kdevelop: Kdevelop
gede: Gede
nemiver: Nemiver
seergdb: Seer
EOF
}

#-------------------------------------------------------------------------------
# Print help page
#-------------------------------------------------------------------------------

print_help() {
  cat << EOF

This is a debugger launcher wrapper. Usage:

$0 [debugger opts] [mpiexec opts] [valgrind opts] --program=<program> [arguments]

This wrapper may be run either under MPI, or include an mpi run command.
If no debugger or Valgrind options are specified, the program is run under
the gdb debugger.

Debugger options:

  --debugger             Indicates the program should be debugged
  --debugger=DEBUGGER    Allows selection of the debugger
  DEBUGGER               Same as above (if debugger in known list)
  --debugger=list        Lists debuggers supported by this script
  --asan-bp              Adds a breakpoint for gcc's Address-Sanitizer
  --back-end=GDB         Path to debugger back-end (for graphical front-ends)
  --breakpoints=LIST     Comma-separated list of breakpoints to insert
  --command-file=FILE    Path to debugger commands file
  --ranks=LIST           Comma-separated list of MPI ranks to debug;
                         if specified, other ranks are run directly.
  --terminal=TERM        Select terminal type to use for console debugger

  Other, standard options specific to each debugger may also be
  used, as long as they do not conflict with options in this script.

MPI options:

  If it recognizes mpi execution commands, this launcher will re-run
  itself under MPI, using the provided options. This allows simply
  prefixing debug options to a command-line, and may allow for
  support of parallel debuggers.

Valgrind options:

  --valgrind             Indicates the program should be run under Valgrind
  --valgrind=VALGRIND    Allows selection of the valgrind path
  VALGRIND               Same as above

  Other valgrind options may be used. Most importantly, when the
  --vgdb-errors=<num> option is used, the progam is run under a Valgrind
  gdb server, and debugged with the specified gdb debugger interface.
  When no debugger option is provided, or the (deprecated)
  --db-attach=yes option is used, the program is run under Valgrind,
  possibly under separate terminals when run under MPI.

Program options:

  --program=PROGRAM      Specifies the program that should be debugged
  PROGRAM                Same as above

  Program arguments should follow the program name or path.

EOF
}

#-------------------------------------------------------------------------------
# Helper predicates
#-------------------------------------------------------------------------------

is_known_debugger() {
  case "$1" in
    gdb|cgdb|cuda-gdb|gdbgui|ddd|emacs|kdbg|kdevelop|gede|nemiver|seergdb)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

is_mpi_launcher() {
  case "$1" in
    mpiexec|mpirun|srun|aprun|poe)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

find_executable() {
  target="$1"
  case "$target" in
    */*)
      if [ -f "$target" ] && [ -x "$target" ]; then
        echo "$target"
        return 0
      fi
      ;;
    *)
      if [ -f "./$target" ] && [ -x "./$target" ]; then
        echo "./$target"
        return 0
      fi
      save_ifs="$IFS"
      IFS=':'
      for d in $PATH; do
        if [ -f "$d/$target" ] && [ -x "$d/$target" ]; then
          echo "$d/$target"
          IFS="$save_ifs"
          return 0
        fi
      done
      IFS="$save_ifs"
      ;;
  esac
  return 1
}

#-------------------------------------------------------------------------------
# Determine rank id when run under MPI
#-------------------------------------------------------------------------------

init_rank_id() {
  rank_id=-1
  if [ -n "$PMIX_RANK" ]; then
    rank_id="$PMIX_RANK"
  elif [ -n "$PMI_RANK" ]; then
    rank_id="$PMI_RANK"
  elif [ -n "$OMPI_COMM_WORLD_RANK" ]; then
    rank_id="$OMPI_COMM_WORLD_RANK"
  elif [ -n "$PMI_ID" ]; then
    rank_id="$PMI_ID"
  elif [ -n "$SLURM_PROCID" ]; then
    rank_id="$SLURM_PROCID"
  elif [ -n "$MP_CHILD" ]; then
    rank_id="$MP_CHILD"
  elif [ -n "$MPIRUN_RANK" ]; then
    rank_id="$MPIRUN_RANK"
  elif [ -n "$SMPIRUN_RANK" ]; then
    rank_id="$SMPIRUN_RANK"
  elif [ -n "$MPI_RANKID" ]; then
    rank_id="$MPI_RANKID"
  fi
}

#-------------------------------------------------------------------------------
# Generate a gdb command file
#-------------------------------------------------------------------------------

gen_cmd_file() {
  target_remote="$1"
  if [ "$rank_id" -gt -1 ]; then
    f_name="./commands_r${rank_id}.gdb"
  else
    f_name="./commands.gdb"
  fi

  {
    echo "set breakpoint pending on"
    if [ -n "$target_remote" ]; then
      echo "$target_remote"
    fi
    echo "b main"
    if [ -z "$target_remote" ]; then
      # Build run line with arguments from $2, $3, ...
      shift
      shift
      run_cmd="run"
      for a in "$@"; do
        case "$a" in
          *" "*) run_cmd="$run_cmd \"$a\"" ;;
          *) run_cmd="$run_cmd $a" ;;
        esac
      done
      echo "$run_cmd"
    fi
    if [ -n "$target_remote" ]; then
      echo "continue"
    fi
    echo "b exit"
    echo "b MPI_Abort"

    if [ "$asan_bp" = true ]; then
      echo "b __asan::ReportGenericError"
      echo "b __asan_on_error"
    fi

    if [ -n "$breakpoints" ]; then
      save_ifs="$IFS"
      IFS=','
      for bp in $breakpoints; do
        echo "b $bp"
      done
      IFS="$save_ifs"
    fi

    if [ -n "$cmd_files_to_append" ]; then
      for cf in $cmd_files_to_append; do
        if [ -f "$cf" ]; then
          cat "$cf"
        fi
      done
    fi
  } > "$f_name"

  echo "$f_name"
}

#-------------------------------------------------------------------------------
# Find available port (for gdbgui)
#-------------------------------------------------------------------------------

find_free_port() {
  p=$(python3 -c "import socket; s=socket.socket(); s.bind(('',0)); print(s.getsockname()[1]); s.close()" 2>/dev/null)
  if [ -n "$p" ]; then
    echo "$p"
  else
    echo "5000"
  fi
}

#-------------------------------------------------------------------------------
# Run gdb-based or compatible debugger with minimal options
#-------------------------------------------------------------------------------

run_minimal_debug() {
  gdb="${backend_gdb:-gdb}"

  case "$debugger_ui" in
    kdevelop)
      exec "$debugger_bin" --debug "$gdb" "$@"
      ;;
    kdbg)
      prog="$1"
      shift
      if [ $# -gt 0 ]; then
        exec "$debugger_bin" -a "$*" "$prog"
      else
        exec "$debugger_bin" "$prog"
      fi
      ;;
    gede)
      exec "$debugger_bin" --args "$@"
      ;;
    nemiver)
      if [ "$gdb" != "gdb" ]; then
        exec "$debugger_bin" "--gdb-binary=$gdb" "$@"
      else
        exec "$debugger_bin" "$@"
      fi
      ;;
    *)
      exec "$debugger_bin" "$@"
      ;;
  esac
}

#-------------------------------------------------------------------------------
# Run gdb-based or compatible debugger
#-------------------------------------------------------------------------------

run_gdb_debug() {
  target_remote="$1"
  shift
  prog="$1"

  f_name=$(gen_cmd_file "$target_remote" "$@")

  case "$debugger_ui" in
    gdbgui)
      port=$(find_free_port)
      if [ "$backend_gdb" != "gdb" ]; then
        exec "$debugger_bin" -p "$port" --gdb "$backend_gdb" --gdb-cmd "$backend_gdb -x $f_name $prog" $other_dbg_opts
      else
        exec "$debugger_bin" -p "$port" --gdb-cmd "gdb -x $f_name $prog" $other_dbg_opts
      fi
      ;;
    ddd)
      if [ "$backend_gdb" != "gdb" ]; then
        exec "$debugger_bin" --debugger "$backend_gdb" $other_dbg_opts -x "$f_name" "$prog"
      else
        exec "$debugger_bin" $other_dbg_opts -x "$f_name" "$prog"
      fi
      ;;
    seergdb)
      if [ "$backend_gdb" != "gdb" ]; then
        exec "$debugger_bin" --gdb-program "$backend_gdb" --run --interpreter=mi --command="$f_name" --gdb-arguments "$other_dbg_opts" "$prog"
      else
        exec "$debugger_bin" --run --interpreter=mi --command="$f_name" --gdb-arguments "$other_dbg_opts" "$prog"
      fi
      ;;
    emacs)
      cmd_str="${backend_gdb:-gdb} -i=mi -x $f_name $prog"
      exec "$debugger_bin" --eval "(gdb \"$cmd_str\")"
      ;;
    *)
      # Terminal or cgdb
      case "$term" in
        *gnome-terminal*)
          exec "$term" -- "$debugger_bin" $other_dbg_opts -x "$f_name" "$prog"
          ;;
        *)
          cmd_string="$debugger_bin"
          for c in $other_dbg_opts; do
            case "$c" in
              *" "*) cmd_string="$cmd_string \"$c\"" ;;
              *) cmd_string="$cmd_string $c" ;;
            esac
          done
          cmd_string="$cmd_string -x \"$f_name\" \"$prog\""
          set -x
          exec "$term" -e "$cmd_string"
          set +x
          ;;
      esac
      ;;
  esac
}

#-------------------------------------------------------------------------------
# Run program under Valgrind
#-------------------------------------------------------------------------------

run_valgrind() {
  debugger_attach=false
  case "$valgrind_opts" in
    *--db-*) debugger_attach=true ;;
  esac

  if [ "$debugger_attach" = true ]; then
    if [ "$rank_id" -lt 0 ]; then
      exec "$valgrind_bin" $valgrind_opts "$@"
    else
      t="${custom_term:-${TERM:-xterm}}"
      cmd_line="$valgrind_bin $valgrind_opts"
      for a in "$@"; do
        case "$a" in
          *" "*) cmd_line="$cmd_line \"$a\"" ;;
          *) cmd_line="$cmd_line $a" ;;
        esac
      done
      cmd_line="$cmd_line ; read"
      exec "$t" -e "$cmd_line"
    fi
  else
    if [ "$rank_id" -gt 0 ]; then
      "$valgrind_bin" $valgrind_opts "$@" > "valgrind.out.r${rank_id}" 2>&1
      exit $?
    else
      exec "$valgrind_bin" $valgrind_opts "$@"
    fi
  fi
}

#-------------------------------------------------------------------------------
# Run Valgrind gdb server and debugger
#-------------------------------------------------------------------------------

run_vgdb_debug() {
  tmp_err=$(mktemp "${TMPDIR:-/tmp}/cs_vgdb_err.XXXXXX")
  "$valgrind_bin" $valgrind_opts "$@" 2>"$tmp_err" &
  p0=$!

  target_cmd=""
  vgdb_pid=""

  while kill -0 "$p0" 2>/dev/null; do
    if grep "target remote" "$tmp_err" >/dev/null 2>&1; then
      target_cmd=$(grep "target remote" "$tmp_err" | head -n 1)
      target_cmd="target remote${target_cmd#*target remote}"
      vgdb_bin=$(echo "$target_cmd" | awk '{print $4}')
      if [ -n "$vgdb_bin" ] && [ ! -f "$vgdb_bin" ]; then
        case "$vgdb_bin" in
          /usr/lib/*)
            if [ -f /usr/bin/vgdb ]; then
              target_cmd=$(echo "$target_cmd" | sed 's|/usr/lib/[^ ]*|/usr/bin/vgdb|')
            fi
            ;;
        esac
      fi
      vgdb_pid=$(echo "$target_cmd" | sed -n 's/.*--pid=\([0-9]*\).*/\1/p')
      break
    fi
    sleep 0.1
  done

  run_gdb_debug "$target_cmd" "$@"
  p1_exit=$?

  if kill -0 "$p0" 2>/dev/null; then
    if [ -n "$vgdb_pid" ]; then
      vgdb_exec="vgdb"
      case "$valgrind_bin" in
        */*) vgdb_exec="$(dirname "$valgrind_bin")/vgdb" ;;
      esac
      "$vgdb_exec" "--pid=$vgdb_pid" "v.kill" 2>/dev/null || kill "$p0" 2>/dev/null
    else
      kill "$p0" 2>/dev/null
    fi
  fi

  wait "$p0" 2>/dev/null
  p0_exit=$?
  rm -f "$tmp_err"
  return "$p0_exit"
}

#-------------------------------------------------------------------------------
# Command-line processing
#-------------------------------------------------------------------------------

if [ $# -eq 0 ]; then
  print_help
  exit 1
fi

debugger_bin=""
valgrind_bin=""
mpiexec_bin=""
program_bin=""

other_dbg_opts=""
valgrind_opts=""
mpiexec_opts=""

asan_bp=false
backend_gdb="gdb"
breakpoints=""
cmd_files_to_append=""
rank_filter=""
custom_term=""
need_terminal=false
file_next=false

program_found=false

while [ $# -gt 0 ]; do
  a="$1"

  if [ "$file_next" = true ]; then
    cmd_files_to_append="${cmd_files_to_append:+$cmd_files_to_append }$a"
    file_next=false
    shift
    continue
  fi

  case "$a" in
    --debugger=list)
      print_debuggers
      exit 0
      ;;
    -h|--help)
      print_help
      exit 0
      ;;
    -x)
      file_next=true
      shift
      continue
      ;;
    --asan-bp)
      asan_bp=true
      shift
      continue
      ;;
    --back-end=*)
      backend_gdb="${a#--back-end=}"
      shift
      continue
      ;;
    --breakpoints=*)
      bp_val="${a#--breakpoints=}"
      breakpoints="${breakpoints:+$breakpoints,}$bp_val"
      shift
      continue
      ;;
    --command-file=*)
      cf_val="${a#--command-file=}"
      cmd_files_to_append="${cmd_files_to_append:+$cmd_files_to_append }$cf_val"
      shift
      continue
      ;;
    --ranks=*)
      rank_filter="${a#--ranks=}"
      shift
      continue
      ;;
    --terminal=*)
      custom_term="${a#--terminal=}"
      shift
      continue
      ;;
    --tui)
      need_terminal=true
      shift
      continue
      ;;
    --debugger=*)
      debugger_bin="${a#--debugger=}"
      shift
      continue
      ;;
    --debugger)
      debugger_bin="gdb"
      shift
      continue
      ;;
    --valgrind=*)
      valgrind_bin="${a#--valgrind=}"
      shift
      continue
      ;;
    --valgrind)
      valgrind_bin="valgrind"
      shift
      continue
      ;;
    --mpiexec=*)
      mpiexec_bin="${a#--mpiexec=}"
      shift
      continue
      ;;
    --mpiexec)
      mpiexec_bin="mpiexec"
      shift
      continue
      ;;
    --program=*)
      program_bin="${a#--program=}"
      shift
      set -- "$program_bin" "$@"
      program_found=true
      break
      ;;
    --program)
      shift
      program_bin="$1"
      program_found=true
      break
      ;;
    -*)
      # Generic option
      if [ -n "$valgrind_bin" ]; then
        valgrind_opts="${valgrind_opts:+$valgrind_opts }$a"
      elif [ -n "$mpiexec_bin" ]; then
        mpiexec_opts="${mpiexec_opts:+$mpiexec_opts }$a"
      else
        other_dbg_opts="${other_dbg_opts:+$other_dbg_opts }$a"
      fi
      shift
      continue
      ;;
    *)
      # Non-option argument: could be a tool name or program
      base=$(basename "$a")
      base_noext="${base%%.*}"
      if is_mpi_launcher "$base_noext"; then
        mpiexec_bin="$a"
        shift
        continue
      elif is_known_debugger "$base"; then
        debugger_bin="$a"
        shift
        continue
      elif [ "$base" = "valgrind" ]; then
        valgrind_bin="$a"
        shift
        continue
      else
        # Candidate executable program
        p_exec=$(find_executable "$a")
        if [ -n "$p_exec" ] || [ -n "$valgrind_bin" ]; then
          program_bin="$a"
          program_found=true
          break
        else
          # Positional option argument (e.g. mpiexec -n 4)
          if [ -n "$mpiexec_bin" ]; then
            mpiexec_opts="${mpiexec_opts:+$mpiexec_opts }$a"
          else
            other_dbg_opts="${other_dbg_opts:+$other_dbg_opts }$a"
          fi
          shift
          continue
        fi
      fi
      ;;
  esac
done

if [ "$program_found" != true ] || [ -z "$program_bin" ]; then
  echo "usage: $0 [debugger opts] [mpiexec opts] [valgrind opts] --program=<program> [arguments]" >&2
  exit 1
fi

# Default debugger determination
if [ -z "$debugger_bin" ]; then
  need_gdb=true
  if [ -n "$valgrind_bin" ]; then
    need_gdb=false
    case "$valgrind_opts" in
      *--vgdb*) need_gdb=true ;;
    esac
    case "$valgrind_opts" in
      *--vgdb=off*) need_gdb=false ;;
    esac
  fi
  if [ "$need_gdb" = true ]; then
    debugger_bin="gdb"
  fi
fi

# Re-run under MPI if mpiexec was in command
if [ -n "$mpiexec_bin" ]; then
  exec $mpiexec_bin $mpiexec_opts "$0" ${debugger_bin:+--debugger="$debugger_bin"} $other_dbg_opts ${valgrind_bin:+--valgrind="$valgrind_bin"} $valgrind_opts --program="$@"
fi

# Direct run or debugging
init_rank_id

# Check rank filter
if [ -n "$rank_filter" ]; then
  in_filter=false
  save_ifs="$IFS"
  IFS=','
  for r in $rank_filter; do
    if [ "$rank_id" = "$r" ]; then
      in_filter=true
      break
    fi
  done
  IFS="$save_ifs"

  if [ "$in_filter" = false ]; then
    export CS_EXIT_ON_ERROR=ignore
    exec "$@"
  fi
fi

# Valgrind vgdb flag
vgdb=false
if [ -n "$valgrind_bin" ]; then
  case "$valgrind_opts" in
    *--vgdb*) vgdb=true ;;
  esac
  case "$valgrind_opts" in
    *--vgdb=off*) vgdb=false ;;
    *--db-attach*|*--db-*) need_terminal=true ;;
  esac
fi

# Debugger UI determination
debugger_ui="terminal"
if [ -n "$debugger_bin" ]; then
  dbg_name=$(basename "$debugger_bin")
  if is_known_debugger "$dbg_name" && [ "$dbg_name" != "gdb" ] && [ "$dbg_name" != "cuda-gdb" ]; then
    debugger_ui="$dbg_name"
  else
    case "$dbg_name" in
      *emacs*) debugger_ui="emacs" ;;
    esac
  fi
fi

if [ "$need_terminal" = true ]; then
  debugger_ui="terminal"
fi

# Terminal configuration
term="${TERM:-xterm}"
case "$term" in
  xterm*|"") term="xterm" ;;
esac
if [ -n "$custom_term" ]; then
  term="$custom_term"
fi

# Dispatch execution
if [ "$vgdb" = true ]; then
  run_vgdb_debug "$@"
elif [ -n "$debugger_bin" ]; then
  case "$debugger_bin" in
    kdbg|kdevelop|gede|nemiver)
      run_minimal_debug "$@"
      ;;
    *)
      run_gdb_debug "" "$@"
      ;;
  esac
elif [ -n "$valgrind_bin" ]; then
  run_valgrind "$@"
else
  exit 1
fi

